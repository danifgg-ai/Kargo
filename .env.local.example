# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth (configured in Supabase dashboard)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Bancard VPOS
BANCARD_PRIVATE_KEY=your-bancard-private-key
BANCARD_PUBLIC_KEY=your-bancard-public-key
NEXT_PUBLIC_BANCARD_BASE_URL=https://vpos.infonet.com.py

# SIFEN (Facturación Electrónica Paraguay)
SIFEN_RUC_EMISOR=your-ruc
SIFEN_RAZON_SOCIAL=KARGO S.A.
SIFEN_TIMBRADO=your-timbrado
SIFEN_CERTIFICADO_BASE64=your-cert-base64
SIFEN_CERTIFICADO_PASSWORD=your-cert-password
SIFEN_AMBIENTE=mock

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KARGO
NEXT_PUBLIC_APP_CURRENCY=PYG
NEXT_PUBLIC_APP_TIMEZONE=America/Asuncion

# Database (Supabase PostgreSQL - for Prisma)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
